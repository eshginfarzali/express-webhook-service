# Copy to .env and adjust. Every variable is validated at startup (src/config/index.ts).
# Generate secrets with: openssl rand -hex 32

NODE_ENV=development
HOST=0.0.0.0
# Port the service listens on (inside the container as well).
PORT=3300
# Host port published by docker compose.
HOST_PORT=3300
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = none).
TRUST_PROXY=0

# SQLite database file (created on first start).
DATABASE_PATH=./data/webhooks.db

# Comma-separated "source:secret" pairs. Each source gets POST /webhooks/<source>.
# Secrets must be at least 16 characters.
WEBHOOK_SECRETS=billing:replace-with-a-long-random-secret,crm:replace-with-another-long-secret
# Max allowed clock skew between the x-webhook-timestamp header and server time.
SIGNATURE_TOLERANCE_SECONDS=300
BODY_LIMIT_BYTES=524288

# Bearer token for the /events admin API (min 24 characters).
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Per source + client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Retry policy: exponential backoff with full jitter, then dead-letter.
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=300000

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
# How long a claimed event is locked before another worker may reclaim it.
WORKER_LEASE_MS=60000

# Optional: forward accepted events to this URL. If unset, events are logged.
DELIVERY_URL=
DELIVERY_TIMEOUT_MS=10000

SHUTDOWN_TIMEOUT_MS=10000
